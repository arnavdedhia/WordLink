# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets (this app must stay local; never commit credentials)
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
*.swp
*.swo

# iPhone screenshots captured over USB (folder kept by nested .gitignore)
word_solver/capture/captures/*
!word_solver/capture/captures/.gitignore

# Vision debug dumps from --debug / Debug timings (folder kept by nested .gitignore)
word_solver/vision/debug/*
!word_solver/vision/debug/.gitignore

# Frequency lists downloaded by scripts/build_dictionary.py
word_solver/data/.cache/
